    <description>BlazorKit is an open source CMS and Application Framework that provides advanced functionality for developing web, mobile, and desktop applications on .NET. It supports Static Blazor, Blazor Server, Blazor WebAssembly, or Blazor Hybrid (via .NET MAUI).</description>
    <language>en-US</language>
    <tags>Web ASP.NET Blazor Oqtane Modular Multi-Tenant "Open Source" "SQL Server" MySQL PostgreSQL SQLite</tags>
    <readme>README.md</readme>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
  </metadata>
</package>